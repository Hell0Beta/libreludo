# Tailscale auth key for the `tailscale` sidecar in docker-compose.yml.
#
# Generate one in the Tailscale admin console: Settings -> Keys -> Generate auth key.
# A reusable key is the right choice here (the sidecar re-authenticates on a cold start); an
# ephemeral key also works, but the node then disappears whenever the container is down.
#
# .env is gitignored; keep it that way. Never bake this into the image or a compose file.
TS_AUTHKEY=
